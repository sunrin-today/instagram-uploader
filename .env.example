# 선린투데이 프로젝트의 설정 파일입니다
# .env 파일을 만들어서 아래의 설정을 복붙해주세요

# 급식 API 서버 주소입니다
API_BASE_URL="https://api.sunrin.kr"

# 급식 API 인증 키입니다 (X-API-Key)
API_KEY="your-api-key"

# 이미지 생성시에 사용되는 학교 이름입니다
SCHOOL_NAME="선린인터넷고등학교"

# Instagram Graph API (공식)
# Meta 앱 대시보드에서 생성한 토큰과 계정 ID
INSTAGRAM_ACCESS_TOKEN="your_instagram_access_token"
INSTAGRAM_IG_ID="1784146540991058488"
INSTAGRAM_USERNAME="sunrin_today"
# 토큰 갱신에 사용. 필수는 아님
INSTAGRAM_APP_SECRET=""
# 피드 게시물을 이 개수로 유지합니다. 오래된 글부터 삭제합니다
INSTAGRAM_MEDIA_LIMIT=365
# 게시물 삭제는 공식 문서상 Facebook Login + instagram_manage_contents 가 필요합니다.
# Instagram Login 토큰으로 삭제가 거절되면 아래를 설정하세요.
# INSTAGRAM_DELETE_ACCESS_TOKEN=""
# INSTAGRAM_DELETE_GRAPH_API_BASE="https://graph.facebook.com/v25.0"

# 공식 API는 공개 이미지 URL이 필요합니다.
# 로컬 테스트/배포 모두 GCS 버킷에 JPEG를 올린 뒤 signed URL을 사용합니다.
GCS_BUCKET="sunrin-today-instagram"

# Job 실행 시간을 설정합니다
# 자세한 내용은 https://cloud.google.com/scheduler/docs/configuring/cron-job-schedules?hl=ko를 참고해주세요
INTERVAL="0 7 * * 1-5"

# 서비스 관련 알림을 보내기 위한 디스코드 웹훅 URL입니다
# 필수가 아닌 설정입니다
DISCORD_WEBHOOK_URL="your_discord_webhook_url"

# 오류 웹훅에서 멘션할 Discord 유저 ID (쉼표 구분). Secret Manager 권장
DISCORD_ERROR_MENTION_IDS=""

RANDOM_DELAY=10
